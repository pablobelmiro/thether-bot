{
  "name": "telegram-claude-tether",
  "version": "0.1.0",
  "description": "Control the Claude Code sessions on your own machine from a web dashboard and Telegram.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tether": "bin/tether.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "locales",
    "docs/TELEGRAM_AGENT.md",
    "docs/assets",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"TETHER_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:server": "TETHER_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node bin/tether.mjs",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablobelmiro/thether-bot.git"
  },
  "homepage": "https://github.com/pablobelmiro/thether-bot#readme",
  "bugs": "https://github.com/pablobelmiro/thether-bot/issues",
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "bot",
    "tmux",
    "dashboard",
    "agent"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "grammy": "^1.46.0",
    "hono": "^4.13.17",
    "i18next": "^25.10.10",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.5",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "zustand": "^5.1.0"
  }
}
