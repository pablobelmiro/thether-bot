# Optional: seed settings with `tether import-env .env` (delete the file afterwards).
# Everything here can also be set in the dashboard.
TETHER_PASSWORD=change-me-to-something-long
# Comma-separated, with country code
TETHER_PHONES=15551234567
# From @BotFather
TETHER_TELEGRAM_TOKEN=
# en | pt-BR | es
TETHER_LOCALE=en
# ask | bypass
TETHER_PERMISSION_MODE=ask
